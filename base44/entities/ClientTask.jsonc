{
  "name": "ClientTask",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "CRMRecord or InvestorProfile ID"
    },
    "user_id": {
      "type": "string",
      "description": "The investor's user_id"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "completed"
      ],
      "default": "open"
    },
    "assigned_to": {
      "type": "string",
      "description": "Admin user ID"
    },
    "assigned_name": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high"
      ],
      "default": "normal"
    }
  },
  "required": [
    "client_id",
    "title"
  ]
}