{
  "name": "MagicLinkToken",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to the User entity this link authenticates"
    },
    "email": {
      "type": "string"
    },
    "token": {
      "type": "string",
      "description": "Secure single-use magic login token"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "used": {
      "type": "boolean",
      "default": false,
      "description": "Whether the token has already been consumed"
    }
  },
  "required": [
    "user_id",
    "email",
    "token",
    "expires_at"
  ]
}