{
  "name": "PasswordResetToken",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "token": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "used": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "email",
    "token",
    "expires_at"
  ]
}